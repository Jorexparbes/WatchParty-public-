{
  "rules": {
    ".read": false,
    ".write": false,
    "roomIndex": {
      ".read": "auth != null",
      "$r": {
        ".write": "auth != null && (!data.exists() || data.val() < now - 172800000)",
        ".validate": "newData.isNumber()"
      }
    },
    "rooms": {
      "$r": {
        ".write": "auth != null && !newData.exists() && root.child('roomIndex/' + $r).exists() && root.child('roomIndex/' + $r).val() < now - 172800000",
        "created": {
          ".read": "auth != null",
          ".write": "auth != null && !data.exists()",
          ".validate": "newData.isNumber()"
        },
        "host": {
          ".read": "auth != null",
          ".write": "auth != null && !data.exists()",
          ".validate": "newData.val() === auth.uid"
        },
        "open": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('rooms/' + $r + '/host').val() === auth.uid"
        },
        "video": {
          ".read": "auth != null",
          ".write": "auth != null && (root.child('rooms/' + $r + '/host').val() === auth.uid || root.child('rooms/' + $r + '/open').val() === true)"
        },
        "users": {
          ".read": "auth != null",
          "$u": {
            ".write": "auth != null && auth.uid === $u",
            ".validate": "newData.child('name').isString() && newData.child('name').val().length <= 20"
          }
        },
        "chat": {
          ".read": "auth != null",
          "$m": {
            ".write": "auth != null && !data.exists()",
            ".validate": "newData.child('uid').val() === auth.uid && newData.child('x').isString() && newData.child('x').val().length <= 500"
          }
        },
        "rtc": {
          "$to": {
            ".read": "$to === auth.uid",
            "$m": {
              ".write": "auth != null && (!data.exists() || $to === auth.uid)"
            }
          }
        }
      }
    }
  }
}
